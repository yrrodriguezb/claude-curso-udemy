# Copia a .env y rellena con los valores de Supabase → Project Settings → API.
# La anon key es pública por diseño (la seguridad la da RLS). NUNCA uses aquí la service_role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
PORT=3000
# 127.0.0.1 por defecto; usa 0.0.0.0 solo en despliegue (detrás de proxy/TLS)
HOST=127.0.0.1
# production activa HSTS y upgrade-insecure-requests (requiere servir por HTTPS)
NODE_ENV=development
